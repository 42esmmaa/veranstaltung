{
  "name": "veranstaltung",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit.test.ts",
    "test:db": "node --import tsx --test test/database.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.18",
    "pg": "8.23.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.19.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^12.19.0"
  },
  "packageManager": "pnpm@12.19.0"
}
