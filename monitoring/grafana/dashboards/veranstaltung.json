{
  "uid": "veranstaltungs-api",
  "title": "Veranstaltungs-API",
  "description": "HTTP-Anfragen, Statusklassen und Antwortzeiten aus Prometheus",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Prometheus erreicht die API",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "veranstaltung-prometheus" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"veranstaltungs-api\"}", "instant": true, "range": false }
      ],
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Nicht erreichbar", "color": "red" },
                "1": { "text": "Erreichbar", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP-Anfragen pro Sekunde",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "veranstaltung-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(veranstaltung_http_requests_total{job=\"veranstaltungs-api\"}[$__rate_interval]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "id": 3,
      "title": "HTTP-Serverfehler in fünf Minuten",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "veranstaltung-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(veranstaltung_http_requests_total{job=\"veranstaltungs-api\",status_class=\"5xx\"}[5m])) or 0 * sum(up{job=\"veranstaltungs-api\"} == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 } }
    },
    {
      "id": 4,
      "title": "HTTP-Anfragen nach Statusklasse",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "veranstaltung-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(veranstaltung_http_requests_total{job=\"veranstaltungs-api\"}[$__rate_interval]))",
          "legendFormat": "{{status_class}}",
          "range": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } }
    },
    {
      "id": 5,
      "title": "Antwortzeit p95 nach Route",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "veranstaltung-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(veranstaltung_http_request_duration_seconds_bucket{job=\"veranstaltungs-api\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "range": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
    }
  ]
}
