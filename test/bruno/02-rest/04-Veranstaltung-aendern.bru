meta {
  name: Veranstaltung-aendern
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/veranstaltungen/{{restId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
  If-Match: {{restEtag}}
}

body:json {
  {
    "titel": "Bruno Jazzabend aktualisiert",
    "datum": "2027-02-01T19:00:00+01:00",
    "kategorie": "KONZERT",
    "preis": "12.50",
    "schlagwoerter": [
      "bruno"
    ]
  }
}

script:post-response {
  if (res.getStatus() === 204) bru.setVar('restEtag', res.getHeader('etag'));
}

tests {
  test('Veranstaltung-aendern', function () {
    expect(res.getStatus()).to.equal(204);
    expect(res.getHeader('etag')).to.equal('"1"');
  });
}
