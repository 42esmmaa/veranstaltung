meta {
  name: Veranstaltung-anlegen
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/veranstaltungen
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "titel": "Bruno Jazzabend",
    "datum": "2027-02-01T19:00:00+01:00",
    "kategorie": "KONZERT",
    "preis": "12.50",
    "schlagwoerter": [
      "bruno"
    ]
  }
}

script:pre-request {
  bru.setVar('restId', '');
  bru.setVar('restEtag', '');
  bru.setVar('ticketId', '');
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar('restId', res.getHeader('location').split('/').pop());
    bru.setVar('restEtag', res.getHeader('etag'));
  }
}

tests {
  test('Veranstaltung-anlegen', function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader('location')).to.match(/\/veranstaltungen\/\d+$/);
    expect(res.getHeader('etag')).to.equal('"0"');
  });
}
