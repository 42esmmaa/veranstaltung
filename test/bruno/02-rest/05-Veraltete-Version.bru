meta {
  name: Veraltete-Version
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/veranstaltungen/{{restId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
  If-Match: "0"
}

body:json {
  {
    "titel": "Bruno Jazzabend",
    "datum": "2027-02-01T19:00:00+01:00",
    "kategorie": "KONZERT",
    "preis": "12.50",
    "schlagwoerter": [
      "bruno"
    ]
  }
}

tests {
  test('Veraltete-Version', function () {
    expect(res.getStatus()).to.equal(412);
    expect(res.getBody().status).to.equal(412);
  });
}
