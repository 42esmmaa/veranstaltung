meta {
  name: Validierungsfehler
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/veranstaltungen
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "titel": "Bruno Jazzabend",
    "datum": "2027-02-01T19:00:00+01:00",
    "kategorie": "KONZERT",
    "preis": "ungueltig",
    "schlagwoerter": [
      "bruno"
    ]
  }
}

tests {
  test('Validierungsfehler', function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().errors.some((error) => error.feld === 'preis')).to.equal(true);
  });
}
